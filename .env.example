# Zugangsdaten des Firebase-Projekts.
#
# Zum lokalen Entwickeln: diese Datei nach `.env.local` kopieren und die Werte
# eintragen. Für die veröffentlichte App gehören dieselben Werte als Secrets in
# die GitHub-Einstellungen (Settings → Secrets and variables → Actions).
#
# Woher die Werte kommen, steht Schritt für Schritt in der README.md.
#
# Ohne diese Datei läuft die App im Probemodus: voll bedienbar, aber nur auf
# diesem einen Gerät und ohne Abgleich mit der zweiten Person.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_MESSAGING_SENDER_ID=
